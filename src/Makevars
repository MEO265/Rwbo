INSTDIR=../inst
OPENWBO_MAKE_FLAGS = CXX="$(CXX)" CPPFLAGS="$(CPPFLAGS)" CXXFLAGS="$(CXXFLAGS)" LDFLAGS="$(LDFLAGS)"

all: wbo

wbo:
	cd open_wbo && if [ "$$(uname -s)" = "Darwin" ]; then \
		$(MAKE) r $(OPENWBO_MAKE_FLAGS) OPENWBO_WARNFLAGS=; \
	else \
		$(MAKE) rs $(OPENWBO_MAKE_FLAGS) || $(MAKE) r $(OPENWBO_MAKE_FLAGS); \
	fi
	mkdir -p $(INSTDIR)/bin
	if [ "$$(uname -s)" = "Darwin" ]; then \
		cp -f open_wbo/open-wbo_release$(EXEEXT) $(INSTDIR)/bin/open-wbo_static$(EXEEXT); \
	else \
		if [ -f open_wbo/open-wbo_static$(EXEEXT) ]; then \
			cp -f open_wbo/open-wbo_static$(EXEEXT) $(INSTDIR)/bin/open-wbo_static$(EXEEXT); \
		else \
			cp -f open_wbo/open-wbo_release$(EXEEXT) $(INSTDIR)/bin/open-wbo_static$(EXEEXT); \
		fi; \
	fi

clean: clean-src clean-wbo

clean-src:
	rm -f *.o *.so *.rds
	rm -f "$(INSTDIR)/bin/open-wbo_static" "$(INSTDIR)/bin/open-wbo_static.exe"

clean-wbo:
	cd open_wbo && $(MAKE) allclean

.PHONY: all wbo clean clean-src clean-wbo
